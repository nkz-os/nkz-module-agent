# =============================================================================
# Agent — Environment Configuration
# =============================================================================
# Copy to .env for local development. Never commit .env to git.
# =============================================================================

# --- Frontend (Vite dev server) -----------------------------------------------

# Point Vite's /api proxy to a running API. No default to avoid hardcoded URLs.
VITE_PROXY_TARGET=https://your-api-domain

# Base URL the frontend uses to build absolute API calls (src/components/LinkPanel.tsx).
# The frontend host and the API can live on different domains in production.
VITE_API_URL=https://your-api-domain

# --- Backend ------------------------------------------------------------------

APP_NAME=Agent
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/agent

# CORS: comma-separated JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5003","http://localhost:5173"]

# --- Auth -----------------------------------------------------------------
# No Keycloak/JWT config here — this module trusts gateway-injected headers
# (X-Tenant-ID, X-User-ID, X-User-Roles). api-gateway validates the JWT; this
# module never talks to Keycloak. See app/middleware/__init__.py.

# --- Internal service-to-service auth (/internal/* routes) -------------------
# Shared secret with entity-manager and other in-cluster callers. K8s Secret
# `internal-service-secret` (org-level) in production. No default — do not
# hardcode a fallback.
INTERNAL_SERVICE_SECRET=change-me-in-production

# --- Database (required) ------------------------------------------------------
# The identity/link chain and inbound-update dedupe are backed by
# PostgreSQL — admin/metadata only, never time-series/telemetry (that flows
# through Orion-LD subscriptions). app/main.py's startup lifespan calls
# require_postgres_url() and refuses to start without this set (see
# app/config.py). K8s Secret `postgresql-secret` (key `postgres-url`) in
# production. No hardcoded fallback.
POSTGRES_URL=postgresql://user:password@localhost:5432/mydb

# --- Messaging channel (Telegram) ---------------------------------------------
# Bot token from @BotFather. K8s Secret `agent-telegram-secret` (key
# `bot-token`) in production. No default — do not hardcode a fallback.
TELEGRAM_BOT_TOKEN=change-me-in-production

# Shared secret Telegram echoes back as X-Telegram-Bot-Api-Secret-Token on
# every webhook delivery (the `secret_token` param of setWebhook). Compared
# with hmac.compare_digest; unset rejects all inbound updates (fail closed).
# K8s Secret `agent-telegram-secret` (key `webhook-secret`) in production.
TELEGRAM_WEBHOOK_SECRET=change-me-in-production

# Public @username of the bot (no leading @) — used to build the /start deep
# link. Not a secret, but instance-specific: a default here would silently
# point every install's deep links at our own bot.
TELEGRAM_BOT_USERNAME=your_bot_username

# --- Language model ----------------------------------------------------------
# Configurable per deployment: every company installing this platform uses
# its own. Empty by default — a default naming our model or endpoint would
# break their install and leak ours. Unset is NOT a crash: the module starts,
# logs CRITICAL and answers with a not-configured notice (see docs/index.md).
LLM_MODEL=
LLM_API_BASE=
# Provider API key. K8s Secret `agent-llm-secret` (key `api-key`) in
# production. No default — do not hardcode a fallback.
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# --- Module-backed read tools ------------------------------------------------
# URLs of installed modules the agent's read tools call directly. Empty by
# default: a default that names our deployment silently breaks everyone
# else's install.
WEATHER_MAP_URL=
BIOORCH_API_URL=
CUE_API_URL=

# --- Per-turn budget ----------------------------------------------------------
# Hard per-turn budget: without these an agent can loop, and a loop on a
# public endpoint is unbounded spend and unbounded latency.
MAX_ITERATIONS=4
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_TURN=4000
TURN_TIMEOUT_SECONDS=45

# Seconds one tenant's installed-module tool list is cached in memory before
# the next turn re-reads public.module_installations.
REGISTRY_CACHE_SECONDS=60

# --- Spend caps ---------------------------------------------------------------
# The platform rule is fail-open for feature quotas; this is money on a
# publicly reachable route, so the cap is finite by default.
MAX_TURNS_PER_TENANT_DAY=500
MAX_TURNS_PER_ACCOUNT_HOUR=15

# --- Conversation memory ------------------------------------------------------
# Per-account rolling memory window. A thread older than this many hours loads
# as empty and is reclaimed opportunistically on the next save (no cron).
MEMORY_TTL_HOURS=24

# --- Redis (uncomment if your module uses Celery or caching) ----------------
# REDIS_URL=redis://localhost:6379/0

# --- Orion-LD (defaults match the in-cluster service name; override for local dev) --
# ORION_LD_URL=http://orion-ld-service:1026
# CONTEXT_URL=http://api-gateway-service:5000/ngsi-ld-context.json
