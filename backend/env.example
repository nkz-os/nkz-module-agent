# Agent backend configuration. One line per Settings field (app/config.py);
# tests/test_config_surface.py keeps this file, k8s/ and docker-compose.yml in
# lockstep with Settings. Secrets and URLs are empty on purpose.

# App
APP_NAME=Agent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API
API_PREFIX=/api/agent
CORS_ORIGINS=[]

# Auth (internal service-to-service)
INTERNAL_SERVICE_SECRET=

# Database (required)
POSTGRES_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Core URLs (timeseries reader; HMAC_SECRET signs module -> core calls)
TIMESERIES_URL=
HMAC_SECRET=

# Module URLs (empty disables the tool)
WEATHER_MAP_URL=
BIOORCH_API_URL=
CUE_API_URL=

# Linking, dedupe, memory, registry cache
LINK_TOKEN_TTL_SECONDS=600
DEDUPE_TTL_HOURS=24
MEMORY_TTL_HOURS=24
REGISTRY_CACHE_SECONDS=60

# Retention
AUDIT_TEXT_RETENTION_DAYS=90

# LLM
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# Per-turn budget
MAX_ITERATIONS=4
MAX_TOOL_CALLS=8
MAX_TOKENS_PER_TURN=4000
TURN_TIMEOUT_SECONDS=45

# Quotas
MAX_TURNS_PER_TENANT_DAY=500
MAX_TURNS_PER_ACCOUNT_HOUR=15
